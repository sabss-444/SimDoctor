# Copy this file to main/.env and fill in your own values. Never commit main/.env.

# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Gemini API key (https://aistudio.google.com/apikey). Without it the app falls back to rule-based answers.
GEMINI_API_KEY=

# Optional
# GEMINI_MODEL=gemini-flash-latest
# EMBED_MODEL=voyage-4
